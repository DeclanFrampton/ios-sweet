+#[cfg(all(test, m2v_gpu))]
+mod handler_guard_tests {
+    use super::*;
+
+    #[test]
+    fn guarded_scratch_return_on_runtime_thread() {
+        for sizes in [[4096,8192], [8192,4096]] {
+            let device=Device::system_default().expect("Vulkan device");
+            let a=device.mipmap_scratch(sizes[0]).unwrap().unwrap();
+            let b=device.mipmap_scratch(sizes[1]).unwrap().unwrap();
+            let largest=if sizes[0]>sizes[1] {a.raw()} else {b.raw()};
+            crate::exit_guard::spawn(std::thread::Builder::new().name("scratch-return-regression".into()), move || {
+                assert!(!crate::exit_guard::may_call(), "must exercise an unguarded runtime thread");
+                drop(a); // Becomes spare.
+                drop(b); // Releases either the smaller return or the smaller spare.
+                assert!(!crate::exit_guard::may_call(), "release section must have ended");
+            }).unwrap().join().unwrap();
+            let reused=device.mipmap_scratch(8192).unwrap().unwrap();
+            assert_eq!(reused.raw(),largest,"largest spare retained");
+        }
+    }
+
+    #[test]
+    fn guarded_gpu_pool_return_on_runtime_thread() {
+        let device=Device::system_default().expect("Vulkan device");
+        for kind in [crate::gpu_pools::PoolKind::Index, crate::gpu_pools::PoolKind::MeshRecords] {
+            let a=device.lease_pool(kind).unwrap();
+            let b=device.lease_pool(kind).unwrap();
+            let kept=a.raw();
+            crate::exit_guard::spawn(std::thread::Builder::new().name("pool-return-regression".into()),move || {
+                assert!(!crate::exit_guard::may_call());
+                drop(a);drop(b);
+                assert!(!crate::exit_guard::may_call());
+            }).unwrap().join().unwrap();
+            assert_eq!(device.lease_pool(kind).unwrap().raw(),kept);
+        }
+    }
+}
