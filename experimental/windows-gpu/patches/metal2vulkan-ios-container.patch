+++ b/crates/metal2vulkan-runtime/examples/rgb9e5_storage.rs
@@ -0,0 +1,66 @@
+//! GPU regression for packed RGB9E5 compute stores through an integer alias.
+mod common;
+use metal2vulkan::metal::{PixelFormat, TextureUsage};
+use metal2vulkan_runtime::{BlitOption, Device, Origin, PipelineOptions, ResourceOptions, Size, TextureDescriptor};
+
+fn reference(v: [f32;4]) -> u32 {
+    let c: Vec<f64> = v[..3].iter().map(|&x| if x.is_nan() {0.0} else {(x as f64).clamp(0.0,65408.0)}).collect();
+    let max = c.iter().copied().fold(0.0, f64::max);
+    let mut e = if max == 0.0 {0} else {(max.log2().floor() as i32 + 16).max(0)};
+    if (max / 2f64.powi(e-24) + 0.5).floor() == 512.0 {e += 1;}
+    let mut word = (e as u32) << 27;
+    for (i,v) in c.into_iter().enumerate() { word |= ((v / 2f64.powi(e-24) + 0.5).floor() as u32) << (9*i); }
+    word
+}
+fn main() -> common::Result<()> {
+    let d=Device::system_default()?; println!("device: {}", d.name());
+    let lib=d.new_library_with_compile_library(metal2vulkan::library::Library::from_air(include_bytes!("rgb444_probe.bc"))?);
+    let f=lib.new_function_with_name("write_masked")?;
+    let write=d.new_compute_pipeline_state_with_function(&f,&PipelineOptions::default())?;
+    let f=lib.new_function_with_name("read_texels")?;
+    let read=d.new_compute_pipeline_state_with_function(&f,&PipelineOptions::default())?;
+    let edges = [[0.0;4], [1.0,0.5,2.0,0.0], [-1.0,70000.0,0.001,0.0],
+        [f32::NAN,f32::INFINITY,1.0,0.0], [2f32.powi(-25),2f32.powi(-24),0.0,1.0],
+        [1.998046875,1.0,0.0,0.0], [65408.0,1e-8,3.0,0.0]];
+    let (w,h)=(127u64,3u64); let n=(w*h) as usize;
+    let mut seed=0x12345678u32;
+    let values: Vec<[f32;4]>=(0..n).map(|i| if i<edges.len(){edges[i]} else {
+        let mut v=[0.0;4]; for c in &mut v {seed=seed.wrapping_mul(1664525).wrapping_add(1013904223); *c=((seed>>8) as f32 / 16777216.0) * 2f32.powi((i%32) as i32-16);} v
+    }).collect();
+    let input: Vec<u8>=values.iter().flatten().flat_map(|v|v.to_le_bytes()).collect();
+    let input=d.new_buffer_with_bytes(&input,ResourceOptions::shared())?;
+    let masks: Vec<u32>=(0..n).map(|i| if i>7 && i%5==0 {0} else {1}).collect();
+    let mb: Vec<u8>=masks.iter().flat_map(|v|v.to_le_bytes()).collect();
+    let mask=d.new_buffer_with_bytes(&mb,ResourceOptions::shared())?;
+    let row=512u64; let init=d.new_buffer_with_bytes(&vec![0; (row*h) as usize],ResourceOptions::shared())?;
+    for options in [ResourceOptions::shared(),ResourceOptions::private()] {
+        let mut desc=TextureDescriptor::texture_2d(PixelFormat::RGB9E5Float,w,h,false);
+        desc.resource_options=options;desc.usage=TextureUsage::SHADER_READ|TextureUsage::SHADER_WRITE;
+        let tex=d.new_texture(&desc)?;
+        let raw=d.new_buffer_with_bytes(&vec![0xad; (row*h+16) as usize],ResourceOptions::shared())?;
+        let floats=d.new_buffer(n as u64*16,ResourceOptions::shared())?;
+        let q=d.new_command_queue()?;let cb=q.command_buffer()?;
+        let mut b=cb.blit_command_encoder()?;
+        b.copy_from_buffer_to_texture(&init,0,row,row*h,Size::new(w,h,1),&tex,0,0,Origin::new(0,0,0),BlitOption::None)?;b.end_encoding()?;
+        let mut e=cb.compute_command_encoder()?;e.set_compute_pipeline_state(&write)?;e.set_texture(Some(&tex),0)?;
+        e.set_buffer(Some(&input),0,0)?;e.set_buffer(Some(&mask),0,1)?;
+        e.dispatch_threads(Size::new(w,h,1),Size::new(1,1,1))?;e.end_encoding()?;
+        let mut e=cb.compute_command_encoder()?;e.set_compute_pipeline_state(&read)?;e.set_texture(Some(&tex),0)?;
+        e.set_buffer(Some(&floats),0,0)?;e.dispatch_threads(Size::new(w,h,1),Size::new(1,1,1))?;e.end_encoding()?;
+        let mut b=cb.blit_command_encoder()?;
+        b.copy_from_texture_to_buffer(&tex,0,0,Origin::new(0,0,0),Size::new(w,h,1),&raw,8,row,row*h,BlitOption::None)?;b.end_encoding()?;
+        common::run(&cb)?;
+        let got=common::bytes(&raw)?;let sampled=common::bytes(&floats)?;
+        let mut expected=vec![0xad; (row*h+16) as usize];
+        for i in 0..n {let word=if masks[i]==0 {0} else {reference(values[i])};
+            let at=8+(i/w as usize)*row as usize+(i%w as usize)*4;
+            expected[at..at+4].copy_from_slice(&word.to_le_bytes());
+            for c in 0..4 {let at=i*16+c*4;let actual=f32::from_le_bytes(sampled[at..at+4].try_into().unwrap());
+                let want=if c==3 {1.0} else {((word>>(c*9))&511) as f32 * 2f32.powi((word>>27) as i32-24)};
+                assert_eq!(actual,want,"sample {i} channel {c}");}
+        }
+        assert_eq!(got,expected,"packed words and padding");
+        println!("PASS {options:?}: {n} packed compute writes, masked preservation, sampled values, padded readback");
+    }
+    Ok(())
+}
diff --git a/crates/metal2vulkan-runtime/src/blit.rs b/crates/metal2vulkan-runtime/src/blit.rs
index 2af641b..fc02df0 100644
--- a/crates/metal2vulkan-runtime/src/blit.rs
+++ b/crates/metal2vulkan-runtime/src/blit.rs
@@ -568,3 +568,113 @@ impl BlitCommandEncoder {
         core.end_with_replay(EncoderKind::Blit, None, log.map(Replay::Blit))
     }
 }
+
+
+/// Decoder for an experimental host step between ordered GPU transfer batches.
+pub type TextureCpuDecoder = Arc<dyn Fn(&[u8]) -> Result<Vec<u8>, String> + Send + Sync>;
+
+pub(super) struct CpuDecodedCall {
+    source: Buffer,
+    offset: u64,
+    length: u64,
+    destination: Texture,
+    region: super::values::Region,
+    output_row: u64,
+    output_length: u64,
+    decoder: TextureCpuDecoder,
+}
+
+pub(super) struct CpuDecodedUpload {
+    input: Buffer,
+    output: Buffer,
+    call: Arc<CpuDecodedCall>,
+}
+
+impl BlitCommandEncoder {
+    /// Copy source bytes in GPU order, decode after that batch completes, then upload
+    /// the decoded texels before later commands. The callback must issue no GPU work.
+    /// Input/output are bounded, retained, coherent Shared buffers made before the step.
+    pub fn copy_buffer_to_texture_decoded(&mut self, source: &Buffer, offset: u64,
+        length: u64, destination: &Texture, region: super::values::Region,
+        output_row: u64, output_length: u64, decoder: TextureCpuDecoder) -> Result<(), Error> {
+        let call = Arc::new(CpuDecodedCall { source: source.clone(), offset, length,
+            destination: destination.clone(), region, output_row, output_length, decoder });
+        self.log(|_| BlitCall::CpuDecodedUpload(Arc::clone(&call)));
+        self.record_cpu_decoded(call)
+    }
+
+    pub(super) fn record_cpu_decoded(&mut self, call: Arc<CpuDecodedCall>) -> Result<(), Error> {
+        use super::error::internal;
+        if call.length == 0 || call.output_length == 0 || call.length > 128<<20
+            || call.output_length > 128<<20 || call.offset.checked_add(call.length).is_none_or(|end| end > call.source.length()) {
+            return Err(internal("CPU-decoded texture upload bounds"));
+        }
+        self.core.check_device("copy_buffer_to_texture_decoded", call.source.device())?;
+        self.core.check_device("copy_buffer_to_texture_decoded", call.destination.device())?;
+        let input = self.core.device().own_buffer(call.length, ResourceOptions::shared())?;
+        let output = self.core.device().own_buffer(call.output_length, ResourceOptions::shared())?;
+        // These internal, ordinary shared buffers have no separate host/device mirror.
+        if input.contents() != input.device_contents() || output.contents() != output.device_contents() {
+            return Err(internal("CPU-decoded upload requires directly mapped coherent buffers"));
+        }
+        self.unlogged(|e| e.copy_from_buffer_to_buffer(&call.source,call.offset,&input,0,call.length))?;
+        self.core.defer(super::deferred::Deferred::CpuDecodedUpload(Arc::new(CpuDecodedUpload {input,output,call})))
+    }
+}
+
+impl CpuDecodedUpload {
+    pub(super) fn record(&self, command_buffer: &CommandBuffer) -> Result<super::encoder::RecordedSegment, Error> {
+        use super::error::internal;
+        // The scheduler completed all preceding GPU work, including the input copy.
+        // SAFETY: this retained coherent buffer has exactly call.length bytes and no
+        // later GPU writer. The host step runs once before the output batch is submitted.
+        let bytes = unsafe { std::slice::from_raw_parts(self.input.contents().ok_or_else(|| internal("CPU decode input mapping"))?.as_ptr(), self.call.length as usize) };
+        let decoded = (self.call.decoder)(bytes).map_err(|e| internal(&e))?;
+        if decoded.len() as u64 != self.call.output_length { return Err(internal("CPU decoder output length")); }
+        // SAFETY: output is retained, uniquely written by this host step, correctly sized,
+        // directly coherent-mapped, and its GPU read has not been submitted yet.
+        unsafe { std::ptr::copy_nonoverlapping(decoded.as_ptr(),self.output.contents().ok_or_else(|| internal("CPU decode output mapping"))?.as_ptr(),decoded.len()); }
+        let core = EncoderCore::segment(command_buffer,true)?;
+        let mut e = BlitCommandEncoder { core, pattern:None, shadows:Vec::new(), log:None };
+        let r = self.call.region;
+        e.copy_from_buffer_to_texture(&self.output,0,self.call.output_row,0,r.size,
+            &self.call.destination,0,0,r.origin,super::copy_plan::BlitOption::None)?;
+        e.core.end_segment()
+    }
+}
+
+/// Produce tightly packed rows after preceding GPU work completes; callback issues no GPU calls.
+pub type BufferCpuProducer = std::sync::Arc<dyn Fn()->Result<Vec<u8>,String> + Send + Sync>;
+pub(super) struct CpuBufferCall { destination:Buffer,offset:u64,row:u64,tight:u64,rows:u64,producer:BufferCpuProducer }
+pub(super) struct CpuBufferWrite { output:Buffer,call:Arc<CpuBufferCall> }
+impl BlitCommandEncoder {
+    /// Upload host-produced rows in command order, retaining gaps in the destination unchanged.
+    pub fn copy_host_rows_to_buffer(&mut self,destination:&Buffer,offset:u64,row:u64,tight:u64,rows:u64,producer:BufferCpuProducer)->Result<(),Error> {
+        let call=Arc::new(CpuBufferCall{destination:destination.clone(),offset,row,tight,rows,producer});
+        self.log(|_|BlitCall::CpuBufferWrite(Arc::clone(&call)));
+        self.record_cpu_buffer(call)
+    }
+    pub(super) fn record_cpu_buffer(&mut self,call:Arc<CpuBufferCall>)->Result<(),Error> {
+        use super::error::internal;
+        let length=call.tight.checked_mul(call.rows).ok_or_else(||internal("host rows length overflow"))?;
+        let end=call.rows.checked_sub(1).and_then(|n|call.row.checked_mul(n)).and_then(|n|n.checked_add(call.tight)).and_then(|n|call.offset.checked_add(n));
+        if call.tight==0 || call.row<call.tight || length>128<<20 || end.is_none_or(|n|n>call.destination.length()) {return Err(internal("host rows destination bounds"));}
+        self.core.check_device("copy_host_rows_to_buffer",call.destination.device())?;
+        let output=self.core.device().own_buffer(length,ResourceOptions::shared())?;
+        if output.contents()!=output.device_contents() {return Err(internal("host rows require coherent staging"));}
+        self.core.defer(super::deferred::Deferred::CpuBufferWrite(Arc::new(CpuBufferWrite{output,call})))
+    }
+}
+impl CpuBufferWrite {
+    pub(super) fn record(&self,command_buffer:&CommandBuffer)->Result<super::encoder::RecordedSegment,Error> {
+        use super::error::internal;
+        let bytes=(self.call.producer)().map_err(|e|internal(&e))?;
+        if bytes.len() as u64 != self.output.length() {return Err(internal("host rows producer length"));}
+        // SAFETY: coherent staging is retained and this ordered host step uniquely writes it before GPU reads.
+        unsafe {std::ptr::copy_nonoverlapping(bytes.as_ptr(),self.output.contents().ok_or_else(||internal("host rows mapping"))?.as_ptr(),bytes.len());}
+        let core=EncoderCore::segment(command_buffer,true)?;
+        let mut e=BlitCommandEncoder{core,pattern:None,shadows:Vec::new(),log:None};
+        for row in 0..self.call.rows {e.copy_from_buffer_to_buffer(&self.output,row*self.call.tight,&self.call.destination,self.call.offset+row*self.call.row,self.call.tight)?;}
+        e.core.end_segment()
+    }
+}
