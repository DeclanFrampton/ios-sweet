+#[test]
+fn omitted_extended_header_preserves_function_and_metadata() {
+    let mut bytes = Builder::new(vec![FnSpec::new("synthetic", 0, 1)]).build();
+    let public = u64::from_le_bytes(bytes[40..48].try_into().unwrap()) as usize;
+    assert_eq!(&bytes[public - 4..public], b"ENDT");
+    bytes.drain(public - 4..public);
+    for field in [16, 40, 56, 72] {
+        let value = u64::from_le_bytes(bytes[field..field + 8].try_into().unwrap());
+        bytes[field..field + 8].copy_from_slice(&(value - 4).to_le_bytes());
+    }
+    let lib = metallib(&bytes);
+    assert!(lib.extended.is_empty());
+    assert_eq!(lib.functions.len(), 1);
+    assert_eq!(lib.functions[0].name, "synthetic");
+}
