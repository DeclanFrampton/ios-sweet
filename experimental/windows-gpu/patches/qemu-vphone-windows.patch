+static int win32_poll_cap_ms(void)
+{
+    static int cap = -1;
+    if (cap < 0) {
+        const char *value = getenv("VPHONE_WIN32_POLL_MAX_MS");
+        cap = 0;
+        if (value && (qemu_strtoi(value, NULL, 10, &cap) < 0 || cap < 0 || cap > 1000)) {
+            error_report("VPHONE_WIN32_POLL_MAX_MS must be 0..1000; disabled");
+            cap = 0;
+        }
+        if (cap) { info_report("Windows main-loop poll cap: %d ms", cap); }
+    }
+    return cap;
+}
