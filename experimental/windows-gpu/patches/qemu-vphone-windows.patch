+/* Optional bounded wait for Windows hosts whose event wakeups are delayed. */
+#ifndef QEMU_WIN32_POLL_LIMIT_H
+#define QEMU_WIN32_POLL_LIMIT_H
+#include <stdint.h>
+static inline int64_t qemu_win32_poll_limit_ns(int64_t timeout, int cap_ms)
+{
+    int64_t cap = (int64_t)cap_ms * 1000000;
+    return cap_ms > 0 && (timeout < 0 || timeout > cap) ? cap : timeout;
+}
+#endif
