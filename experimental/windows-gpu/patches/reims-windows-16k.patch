+        let ((reserved, committed), peak) = receive.recv_timeout(std::time::Duration::from_secs(10)).unwrap();
+        println!("stack reserved={reserved} initial_committed={committed} recursive_committed={peak}");
+        assert!(reserved >= 8 * 1024 * 1024 - 65536);
+        assert!(committed < reserved / 2);
+        assert!(peak > 1024 * 1024);
+        assert!(peak < reserved);
