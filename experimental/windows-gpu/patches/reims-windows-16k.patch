+    #[test]
+    fn astc_public_images_match_independent_decoder() {
+        for file in [
+            &include_bytes!("../../../../../astc-decode-reference/src/test-data/atlas_small_4x4.astc")[..],
+            &include_bytes!("../../../../../astc-decode-reference/src/test-data/footprint_4x4.astc")[..],
+            &include_bytes!("../../../../../astc-decode-reference/src/test-data/rgb_4x4.astc")[..],
+            &include_bytes!("../../../../../astc-decode-reference/src/test-data/atlas_small_6x6.astc")[..],
+            &include_bytes!("../../../../../astc-decode-reference/src/test-data/footprint_6x6.astc")[..],
+            &include_bytes!("../../../../../astc-decode-reference/src/test-data/rgb_6x6.astc")[..],
+        ] {
+            let axis = |i| u32::from_le_bytes([file[i],file[i+1],file[i+2],0]);
+            let (w,h) = (axis(7),axis(10));
+            let start = std::time::Instant::now();
+            let block = file[4] as u32;
+            let srgb = block == 6;
+            let pixels = decode_format(&file[16..],w,h,block,srgb).unwrap();
+            eprintln!("ASTC Arm fp16 decode {w}x{h}: {:?}",start.elapsed());
+            let mut compared = 0usize;
+            astc_decode::astc_decode(&file[16..],w,h,astc_decode::Footprint::new(block,block),|x,y,rgba| {
+                for (c,want) in rgba.into_iter().enumerate() {
+                    let i = ((y*w+x)*8) as usize + c*2;
+                    let got = half::f16::from_bits(u16::from_le_bytes([pixels[i],pixels[i+1]])).to_f32();
+                    // The independent reference quantizes to UNORM8; Arm retains fp16.
+                    let encoded = want as f32/255.;
+                    let reference = if srgb && c != 3 { if encoded <= 0.04045 { encoded/12.92 } else { ((encoded+0.055)/1.055).powf(2.4) } } else { encoded };
+                    assert!((got - reference).abs() <= 3./255., "{x},{y} ch{c}: {got} vs {want}/255");
+                    compared += 1;
+                }
+            }).unwrap();
+            assert_eq!(compared,(w*h*4) as usize);
+        }
+    }
