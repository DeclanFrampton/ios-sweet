+    #[test]
+    fn astc_gpu_upload_padded_partial_and_rejected_region() {
+        let d = crate::gpu::device::tests::dev();
+        use metal2vulkan::metal::PixelFormat;
+        use reims_vgpu_core::platform::types::{MtlOrigin, MtlSize};
+        for (format,block) in [(204,4u64),(190,6)] {
+        for (w,h) in [(1u64,1u64),(7,3),(120,57)] {
+            let desc = rt::TextureDescriptor::texture_2d(PixelFormat::RGBA16Float, w,h,false);
+            let t = d.raw.new_texture(&desc).unwrap();
+            let state = State::new_format(w,h,format);
+            state.initialize(&t).unwrap();
+            let region = MtlRegion { origin: MtlOrigin {x:0,y:0,z:0}, size: MtlSize {width:w,height:h,depth:1} };
+            let red = constant([65535,0,0,65535]);
+            let row = w.div_ceil(block)*16+16;
+            let rows = h.div_ceil(block);
+            let mut padded = vec![0xab; (row*rows) as usize];
+            for j in 0..rows { for i in 0..w.div_ceil(block) {
+                let at = (j*row+i*16) as usize;
+                padded[at..at+16].copy_from_slice(&red);
+            }}
+            state.upload(&t,region,0,0,&padded,row,0).unwrap();
+            // Actual NVIDIA shader sampling of the decoded backing, rather than CPU decode alone.
+            let lib = d.raw.new_library_with_data(include_bytes!("../../../../tests/suite/fixtures/shaders/compute_sample.metallib")).unwrap();
+            let function = lib.new_function_with_name("sample_k").unwrap();
+            let pipeline = d.raw.new_compute_pipeline_state_with_function(&function, &rt::PipelineOptions::default()).unwrap();
+            let sampler = d.raw.new_sampler_state(&metal2vulkan::bind::SamplerDescriptor::default()).unwrap();
+            let out = d.raw.new_buffer(16,rt::ResourceOptions::shared()).unwrap();
+            let queue = d.raw.new_command_queue().unwrap();
+            let cb = queue.command_buffer().unwrap();
+            let mut enc = cb.compute_command_encoder().unwrap();
+            enc.set_compute_pipeline_state(&pipeline).unwrap();
+            enc.set_texture(Some(&t),0).unwrap();
+            enc.set_sampler_state(Some(&sampler),0).unwrap();
+            enc.set_buffer(Some(&out),0,0).unwrap();
+            enc.dispatch_threads(rt::Size::new(4,1,1),rt::Size::new(1,1,1)).unwrap();
+            enc.end_encoding().unwrap(); cb.commit().unwrap();
+            cb.wait_until_completed_for(std::time::Duration::from_secs(30)).unwrap();
+            assert_eq!(cb.status(), rt::CommandBufferStatus::Completed, "{:?}",cb.error());
+            // SAFETY: the completed command owns no writes and the shared buffer holds 16 bytes.
+            let sampled = unsafe { std::slice::from_raw_parts(out.contents().unwrap().as_ptr(),16) };
+            assert!(sampled.chunks_exact(4).all(|p| p == [255,0,0,255]),"sampled {sampled:?}");
+            let all = rt::Region::new_2d(0,0,w,h);
+            let mut got = vec![0; (w*h*8) as usize];
+            t.get_bytes(&mut got,w*8,0,all,0,0).unwrap();
+            assert!(got.chunks_exact(8).all(|p| p == [0,0x3c,0,0,0,0,0,0x3c]));
+            let mut patch = region;
+            patch.origin.x = if w > block {block} else {0};
+            patch.size.width = (w-patch.origin.x).min(block);
+            patch.size.height = h.min(block);
+            let green = constant([0,65535,0,65535]);
+            state.upload(&t,patch,0,0,&green,16,0).unwrap();
+            t.get_bytes(&mut got,w*8,0,all,0,0).unwrap();
+            let before = got.clone();
+            for y in 0..h { for x in 0..w {
+                let i = ((y*w+x)*8) as usize;
+                let inside = x>=patch.origin.x && x<patch.origin.x+patch.size.width && y<patch.size.height;
+                let wanted = if inside {[0,0,0,0x3c,0,0,0,0x3c]} else {[0,0x3c,0,0,0,0,0,0x3c]};
+                assert_eq!(&got[i..i+8],wanted);
+            }}
+            patch.origin.x = w;
+            assert!(state.upload(&t,patch,0,0,&green,16,0).is_err());
+            t.get_bytes(&mut got,w*8,0,all,0,0).unwrap();
+            assert_eq!(got,before,"rejected upload leaves GPU image intact");
+            assert!(state.upload(&t,region,0,0,&padded[..1],row,0).is_err());
+        }
+        }
+    }
+}
