+//! Narrow ASTC4x4 LDR / ASTC6x6 sRGB fallback for CPU-uploaded, sampled, shared 2D textures.
+//! The guest's block storage is separate from the RGBA16F sampled image. Blits must
+//! not use the sampled image as compressed storage (resource::copied rejects them).
+use astcenc_rs::{ConfigBuilder, Context, Extents, Flags, Profile, Swizzle};
+use metal2vulkan_runtime as rt;
+use reims_vgpu_core::platform::types::MtlRegion;
+use std::cell::RefCell;
+use std::sync::Mutex;
+
+thread_local! {
+    static DECODER: RefCell<Option<(u32, bool, Context)>> = const { RefCell::new(None) };
+}
+
+#[derive(Debug)]
+/// Compressed mip stores shared by a texture and its own-format views.
+pub struct State { levels: Vec<std::sync::Arc<Level>> }
+impl State {
+    /// Descriptor subset with bounded per-level storage and implemented uploads.
+    pub fn accepts(d:&rt::TextureDescriptor) -> bool { Level::accepts(d) }
+    /// Single-level linear4x4 compatibility constructor.
+    pub fn new(w:u64,h:u64)->Self { Self::new_format(w,h,204) }
+    /// Single-level constructor for tested formats.
+    pub fn new_format(w:u64,h:u64,f:u64)->Self { Self::new_mipmapped(w,h,f,1) }
+    /// Allocate distinct block storage for each mip.
+    pub fn new_mipmapped(w:u64,h:u64,f:u64,count:u64)->Self {
+        Self {levels:(0..count).map(|l| std::sync::Arc::new(Level::new_format((w>>l).max(1),(h>>l).max(1),f))).collect()}
+    }
+    /// Guest compressed format remains unchanged in the decoded backing.
+    pub fn format(&self)->u64 { self.levels[0].format() }
+    /// Retain only the mip stores named by a validated runtime view.
+    pub fn subview(&self,base:u64,count:u64)->Result<Self,String> {
+        let end=base.checked_add(count).ok_or("ASTC view range overflow")?;
+        let levels=self.levels.get(base as usize..end as usize).ok_or("ASTC view mip range")?;
+        if levels.is_empty() {return Err("empty ASTC view".into());}
+        Ok(Self {levels:levels.to_vec()})
+    }
+    fn level_view(raw:&rt::Texture,l:u64)->Result<rt::Texture,rt::Error> {
+        raw.new_texture_view_with_levels_slices(metal2vulkan::metal::PixelFormat::RGBA16Float,
+            metal2vulkan::metal::TextureType::Type2D,l..l+1,0..1)
+    }
+    /// Initialize shared levels; private contents remain undefined until GPU upload, as Metal permits.
+    pub fn initialize(&self,raw:&rt::Texture)->Result<(),String> {
+        for (i,state) in self.levels.iter().enumerate() {
+            let view=Self::level_view(raw,i as u64).map_err(|e|format!("ASTC mip view: {e:?}"))?;
+            state.initialize(&view)?;
+        }
+        Ok(())
+    }
+    /// CPU writes are valid only for shared textures and the selected mip.
+    pub fn upload(&self,raw:&rt::Texture,r:MtlRegion,level:u64,slice:u64,bytes:&[u8],row:u64,image:u64)->Result<(),String> {
+        if raw.storage_mode()==rt::StorageMode::Private {return Err("CPU upload to private ASTC texture".into());}
+        let state=self.levels.get(level as usize).ok_or("ASTC upload mip range")?;
+        let view=Self::level_view(raw,level).map_err(|e|format!("ASTC mip view: {e:?}"))?;
+        state.upload(&view,r,0,slice,bytes,row,image)
+    }
+    /// Decode only after the producer's GPU work, then upload the selected shared or private mip.
+    pub fn blit(self:&std::sync::Arc<Self>,e:&mut rt::BlitCommandEncoder,source:&rt::Buffer,offset:u64,row:u64,image:u64,r:MtlRegion,level:u64,slice:u64,target:&rt::Texture)->Result<(),rt::Error> {
+        let Some(state)=self.levels.get(level as usize) else {
+            return Err(rt::Error::Compile(metal2vulkan::error::Error::Internal(metal2vulkan::error::InternalError::new(metal2vulkan::error::InternalKind::Invariant,"ASTC upload mip range"))));
+        };
+        let view=Self::level_view(target,level)?;
+        state.blit(e,source,offset,row,image,r,0,slice,&view)
+    }
+    /// Return original compressed blocks at this command's position, not decoded RGBA16F texels.
+    pub fn readback(self:&std::sync::Arc<Self>,e:&mut rt::BlitCommandEncoder,destination:&rt::Buffer,offset:u64,row:u64,image:u64,r:MtlRegion,level:u64,slice:u64)->Result<(),rt::Error> {
+        let fail=|s:&str|rt::Error::Compile(metal2vulkan::error::Error::Internal(metal2vulkan::error::InternalError::new(metal2vulkan::error::InternalKind::Invariant,s)));
+        let state=self.levels.get(level as usize).ok_or_else(||fail("ASTC readback mip range"))?;
+        let (x,y,w,h,b)=(r.origin.x,r.origin.y,r.size.width,r.size.height,state.block);
+        if slice!=0 || r.origin.z!=0 || r.size.depth!=1 || w==0 || h==0 || x>state.width || y>state.height || w>state.width-x || h>state.height-y || x%b!=0 || y%b!=0 || (w%b!=0 && x+w!=state.width) || (h%b!=0 && y+h!=state.height) {return Err(fail("ASTC readback block region"));}
+        let tight=w.div_ceil(b)*16;let rows=h.div_ceil(b);
+        let required=row.checked_mul(rows-1).and_then(|v|v.checked_add(tight));
+        if row<tight || required.is_none() || (image!=0 && image<required.unwrap()) {return Err(fail("ASTC readback strides"));}
+        let state=std::sync::Arc::clone(state);
+        let producer=std::sync::Arc::new(move || {
+            let blocks=state.blocks.lock().map_err(|_|"ASTC block storage poisoned".to_string())?;
+            let pitch=state.width.div_ceil(b)*16;let mut bytes=Vec::with_capacity((tight*rows) as usize);
+            for j in 0..rows {let start=((y/b+j)*pitch+x/b*16) as usize;bytes.extend_from_slice(&blocks[start..start+tight as usize]);}
+            Ok(bytes)
+        });
+        e.copy_host_rows_to_buffer(destination,offset,row,tight,rows,producer)
+    }
+
+}
+
+#[derive(Debug)]
+/// Original ASTC blocks shared by the texture and its views.
+struct Level {
+    block: u64,
+    format: u64,
+    width: u64,
+    height: u64,
+    blocks: Mutex<Vec<u8>>,
+}
+
+impl Level {
+    /// The descriptor subset with implemented upload semantics.
+    pub fn accepts(d: &rt::TextureDescriptor) -> bool {
+        use metal2vulkan::metal::{TextureType, TextureUsage};
+        d.texture_type == TextureType::Type2D && d.depth == 1
+            && d.array_length == 1 && d.mipmap_level_count > 0 && d.mipmap_level_count <= 1 + u64::from(d.width.max(d.height).max(1).ilog2()) && d.sample_count == 1
+            && d.width > 0 && d.height > 0 && d.width <= 4096 && d.height <= 4096
+            && matches!(d.resource_options.storage_mode(), Ok(rt::StorageMode::Shared | rt::StorageMode::Private))
+            && d.usage.contains(TextureUsage::SHADER_READ)
+            && !d.usage.intersects(TextureUsage::SHADER_WRITE | TextureUsage::RENDER_TARGET)
+    }
+
+    /// Allocate the guest-visible block store.
+    pub fn new(width: u64, height: u64) -> Self {
+        Self::new_format(width, height, 204)
+    }
+
+    /// Guest-visible compressed format, retained across own-format views.
+    pub fn format(&self) -> u64 { self.format }
+
+    /// Allocate compressed storage with the selected tested block footprint.
+    pub fn new_format(width: u64, height: u64, format: u64) -> Self {
+        let block = match format { 204 => 4, 190 => 6, _ => panic!("unsupported ASTC fallback format") };
+        Self { width, height, block, format, blocks: Mutex::new(vec![0; (width.div_ceil(block) * height.div_ceil(block) * 16) as usize]) }
+    }
+
+    /// Start the sampled image as zero blocks decode, including invalid-block colors.
+    pub fn initialize(&self, raw: &rt::Texture) -> Result<(), String> {
+        if raw.storage_mode() == rt::StorageMode::Private { return Ok(()); }
+        let blocks = self.blocks.lock().unwrap();
+        let decoded = decode_format(&blocks, self.width as u32, self.height as u32, self.block as u32, self.format == 190)?;
+        raw.replace_region(rt::Region::new_2d(0, 0, self.width, self.height), 0, 0,
+            &decoded, self.width*8, 0).map_err(|e| format!("ASTC initial decode upload: {e:?}"))
+    }
+
+    /// Validate before mutating either representation; keep padding out of block storage.
+    pub fn upload(&self, raw: &rt::Texture, r: MtlRegion, level: u64, slice: u64,
+        bytes: &[u8], row: u64, image: u64) -> Result<(), String> {
+        let (packed, decoded) = self.prepare(r,level,slice,bytes,row,image)?;
+        let (x,y,w,h) = (r.origin.x,r.origin.y,r.size.width,r.size.height);
+        let tight = w.div_ceil(self.block)*16;
+        let rows = h.div_ceil(self.block);
+        // Serialize writes of both representations, including uploads through an own-format view.
+        let mut blocks = self.blocks.lock().unwrap();
+        raw.replace_region(rt::Region::new_2d(x, y, w, h), 0, 0, &decoded, w*8, 0)
+            .map_err(|e| format!("ASTC decoded upload: {e:?}"))?;
+        let pitch = self.width.div_ceil(self.block) * 16;
+        for j in 0..rows {
+            let at = ((y/self.block+j)*pitch + x/self.block*16) as usize;
+            blocks[at..at+tight as usize].copy_from_slice(&packed[(j*tight) as usize..((j+1)*tight) as usize]);
+        }
+        log::warn!("ASTC CPU decoded upload {w}x{h} at {x},{y}");
+        Ok(())
+    }
+    fn prepare(&self, r:MtlRegion,level:u64,slice:u64,bytes:&[u8],row:u64,image:u64) -> Result<(Vec<u8>,Vec<u8>),String> {
+        let (x, y, w, h) = (r.origin.x, r.origin.y, r.size.width, r.size.height);
+        if level != 0 || slice != 0 || r.origin.z != 0 || r.size.depth != 1
+            || w == 0 || h == 0 || x > self.width || y > self.height
+            || w > self.width - x || h > self.height - y
+            || x % self.block != 0 || y % self.block != 0
+            || (w % self.block != 0 && x + w != self.width)
+            || (h % self.block != 0 && y + h != self.height) {
+            return Err("ASTC fallback requires a valid block-aligned region of level/slice zero".into());
+        }
+        let tight = w.div_ceil(self.block) * 16;
+        let rows = h.div_ceil(self.block);
+        let needed = row.checked_mul(rows - 1).and_then(|n| n.checked_add(tight));
+        if row < tight || needed.is_none_or(|n| n > bytes.len() as u64)
+            || (image != 0 && image < needed.unwrap()) {
+            return Err("ASTC upload source is short or has invalid row/image strides".into());
+        }
+        let mut packed = vec![0; (tight * rows) as usize];
+        for j in 0..rows as usize {
+            packed[j*tight as usize..(j+1)*tight as usize]
+                .copy_from_slice(&bytes[j*row as usize..j*row as usize+tight as usize]);
+        }
+        let decoded = decode_format(&packed, w as u32, h as u32, self.block as u32, self.format == 190)?;
+        Ok((packed,decoded))
+    }
+
+    /// Encode a GPU-ordered compressed buffer upload; CPU decoding happens after its readback.
+    pub fn blit(self: &std::sync::Arc<Self>, e:&mut rt::BlitCommandEncoder, source:&rt::Buffer,
+        offset:u64, row:u64, image:u64, r:MtlRegion, level:u64,slice:u64, target:&rt::Texture) -> Result<(),rt::Error> {
+        let fail = |detail| rt::Error::Compile(metal2vulkan::error::Error::Internal(
+            metal2vulkan::error::InternalError::new(metal2vulkan::error::InternalKind::Invariant,detail)));
+        let (x,y,w,h) = (r.origin.x,r.origin.y,r.size.width,r.size.height);
+        if level != 0 || slice != 0 || r.origin.z != 0 || r.size.depth != 1
+            || w == 0 || h == 0 || x > self.width || y > self.height
+            || w > self.width-x || h > self.height-y || x%self.block != 0 || y%self.block != 0
+            || (w%self.block != 0 && x+w != self.width) || (h%self.block != 0 && y+h != self.height)
+            || row < w.div_ceil(self.block)*16 {
+            return Err(fail("ASTC GPU upload outside supported block-aligned region"));
+        }
+        let state = std::sync::Arc::clone(self);
+        let length = row.checked_mul(r.size.height.div_ceil(state.block).saturating_sub(1))
+            .and_then(|n| n.checked_add(r.size.width.div_ceil(state.block)*16)).unwrap_or(u64::MAX);
+        let decode = std::sync::Arc::new(move |bytes:&[u8]| {
+            let (packed,decoded) = state.prepare(r,level,slice,bytes,row,image)?;
+            let pitch = state.width.div_ceil(state.block)*16;
+            let tight = r.size.width.div_ceil(state.block)*16;
+            let mut blocks = state.blocks.lock().unwrap();
+            for j in 0..r.size.height.div_ceil(state.block) {
+                let at = ((r.origin.y/state.block+j)*pitch+r.origin.x/state.block*16) as usize;
+                blocks[at..at+tight as usize].copy_from_slice(&packed[(j*tight) as usize..((j+1)*tight) as usize]);
+            }
+            log::warn!("ASTC GPU-ordered CPU decode {}x{}",r.size.width,r.size.height);
+            Ok(decoded)
+        });
+        e.copy_buffer_to_texture_decoded(source,offset,length,target,crate::gpu::region(r),
+            r.size.width*8,r.size.width*r.size.height*8,decode)
+    }
+
+}
+
+/// Decode with Arm's default fp16 decode mode, retaining fp16 sampled texels.
+pub fn decode(blocks: &[u8], width: u32, height: u32) -> Result<Vec<u8>, String> {
+    decode_format(blocks, width, height, 4, false)
+}
+
+fn decode_format(blocks: &[u8], width: u32, height: u32, block: u32, srgb: bool) -> Result<Vec<u8>, String> {
+    let expected = width.div_ceil(block) as usize * height.div_ceil(block) as usize * 16;
+    if width == 0 || height == 0 || width > 4096 || height > 4096 || blocks.len() != expected {
+        return Err("invalid ASTC4x4 image extent or block count".into());
+    }
+    DECODER.with(|cell| {
+        let mut slot = cell.borrow_mut();
+        if slot.as_ref().is_none_or(|(b,s,_)| *b != block || *s != srgb) {
+            let config = ConfigBuilder::new().with_profile(if srgb { Profile::LdrSrgb } else { Profile::LdrRgba })
+                .with_block_size(Extents::new(block, block)).with_flags(Flags::DECOMPRESS_ONLY)
+                .build().map_err(|e| format!("ASTC config: {e:?}"))?;
+            *slot = Some((block, srgb, Context::with_threads(1, config).map_err(|e| format!("ASTC context: {e:?}"))?));
+        }
+        let pixels = slot.as_mut().unwrap().2.decompress::<f32>(blocks, Extents::new(width, height), Swizzle::rgba())
+            .map_err(|e| format!("ASTC decode: {e:?}"))?;
+        Ok(pixels.data[0].iter().enumerate().flat_map(|(i,v)| {
+            // astcenc returns encoded sRGB values; the float backing must store linear RGB.
+            let v = if srgb && i % 4 != 3 { if *v <= 0.04045 { *v / 12.92 } else { ((*v + 0.055) / 1.055).powf(2.4) } } else { *v };
+            half::f16::from_f32(v).to_bits().to_le_bytes()
+        }).collect())
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn constant(rgba: [u16;4]) -> [u8;16] {
+        let mut b = [255;16]; b[0] = 0xfc; b[1] = 0xfd;
+        for (i, v) in rgba.into_iter().enumerate() { b[8+i*2..10+i*2].copy_from_slice(&v.to_le_bytes()); }
+        b
+    }
+    #[test]
+    fn astc_decode_constant_odd_sizes_and_invalid_lengths() {
+        for (w,h) in [(1usize,1usize),(7,3),(120,57)] {
+            let b = constant([65535,0,32768,65535]);
+            let blocks = b.repeat(w.div_ceil(4) * h.div_ceil(4));
+            let pixels = decode(&blocks, w as u32, h as u32).unwrap();
+            assert_eq!(pixels.len(), w*h*8);
+            for p in pixels.chunks_exact(8) {
+                assert_eq!(&p[..4], &[0,0x3c,0,0]);
+                assert_eq!(&p[6..], &[0,0x3c]);
+                assert!((half::f16::from_bits(u16::from_le_bytes([p[4],p[5]])).to_f32()-0.5).abs()<0.001);
+            }
+        }
+        assert!(decode(&[0;15], 1, 1).is_err());
+        assert!(decode(&[], 0, 1).is_err());
+    }
+
+    #[test]
+    fn astc_6x6_srgb_midtones_linearize_rgb_but_not_alpha() {
+        let b = constant([32768, 16384, 65535, 32768]);
+        let pixels = decode_format(&b.repeat(4),7,7,6,true).unwrap();
+        for p in pixels.chunks_exact(8) {
+            let f = |c:usize| half::f16::from_bits(u16::from_le_bytes([p[c*2],p[c*2+1]])).to_f32();
+            assert!((f(0)-0.21586).abs()<0.002, "red {}",f(0));
+            assert!((f(1)-0.05127).abs()<0.002, "green {}",f(1));
+            assert_eq!(f(2),1.0);
+            assert!((f(3)-0.5).abs()<0.002, "alpha {}",f(3));
+        }
+        assert!(decode_format(&b,7,7,6,true).is_err());
+        // Switching profiles on a single worker must not retain the previous context.
+        assert_eq!(&decode(&constant([65535,0,0,65535]),1,1).unwrap()[..2], &[0,0x3c]);
+    }
+
+    #[test]
+    fn astc_private_mips_and_offset_view_preserve_order_and_extent() {
+        use metal2vulkan::metal::PixelFormat;
+        use reims_vgpu_core::platform::types::{MtlOrigin,MtlSize};
+        let d=crate::gpu::device::tests::dev();
+        let mut desc=rt::TextureDescriptor::texture_2d(PixelFormat::RGBA16Float,15,13,true);
+        desc.mipmap_level_count=3; desc.resource_options=rt::ResourceOptions::private();
+        let t=d.raw.new_texture(&desc).unwrap();
+        let state=std::sync::Arc::new(State::new_mipmapped(15,13,190,3));
+        state.initialize(&t).unwrap();
+        let queue=d.raw.new_command_queue().unwrap();
+        for level in 0..3u64 {
+            let (w,h)=((15u64>>level).max(1),(13u64>>level).max(1));
+            let blocks=constant([32768,0,0,65535]).repeat((w.div_ceil(6)*h.div_ceil(6)) as usize);
+            let source=d.raw.new_buffer_with_bytes(&blocks,rt::ResourceOptions::shared()).unwrap();
+            let r=MtlRegion{origin:MtlOrigin{x:0,y:0,z:0},size:MtlSize{width:w,height:h,depth:1}};
+            assert!(state.upload(&t,r,level,0,&blocks,w.div_ceil(6)*16,0).is_err());
+            let cb=queue.command_buffer().unwrap(); let mut e=cb.blit_command_encoder().unwrap();
+            state.blit(&mut e,&source,0,w.div_ceil(6)*16,0,r,level,0,&t).unwrap();
+            e.end_encoding().unwrap();cb.commit().unwrap();cb.wait_until_completed_for(std::time::Duration::from_secs(30)).unwrap();
+            assert_eq!(cb.status(),rt::CommandBufferStatus::Completed,"{:?}",cb.error());
+            // Copy private texels into a shared texture for independent readback.
+            let output=d.raw.new_texture(&rt::TextureDescriptor::texture_2d(PixelFormat::RGBA16Float,w,h,false)).unwrap();
