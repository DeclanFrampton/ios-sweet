+        fn GetCurrentThreadStackLimits(low: *mut usize, high: *mut usize);
+
+    }
+    fn stack_usage() -> (usize, usize) {
+        let (mut low, mut high) = (0, 0);
+        unsafe { GetCurrentThreadStackLimits(&mut low, &mut high); }
+        let (mut at, mut committed) = (low, 0);
+        while at < high {
+            let mut info = MemoryInfo::default();
+            assert_ne!(unsafe { VirtualQuery(at as *const std::ffi::c_void, &mut info, std::mem::size_of::<MemoryInfo>()) }, 0);
+            let end = (info.base as usize + info.region_size).min(high);
+            assert!(end > at);
+            if info.state == MEM_COMMIT { committed += end - at; }
+            at = end;
+        }
+        (high - low, committed)
+    }
+    #[inline(never)]
+    fn consume_stack(depth: usize) -> usize {
+        let mut page = [0u8; 8192];
+        std::hint::black_box(&mut page);
+        let value = if depth == 0 { stack_usage().1 } else { consume_stack(depth - 1) };
+        std::hint::black_box(&page);
+        value
+    }
