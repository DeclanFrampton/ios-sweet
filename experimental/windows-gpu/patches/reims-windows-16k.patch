+/* SPDX-License-Identifier: GPL-2.0-or-later OR LGPL-3.0-or-later */
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "reims_vgpu.h"
+#define CHECK(call) do { RvgStatus s=(call); printf("%s: %u %s\n", #call,s,rvg_status_message(s)); if(s) exit(1); } while(0)
+static volatile LONG received_frames=0;
+static void on_frame(void *ctx) {(void)ctx;InterlockedIncrement(&received_frames);}
+int main(int argc,char **argv) {
+ int boundary=argc>1&&!strcmp(argv[1],"boundary");
+ int invalid_length=argc>1&&!strcmp(argv[1],"unaligned-length");
+ int outside=argc>1&&!strcmp(argv[1],"outside");
+ setvbuf(stdout,NULL,_IONBF,0);
+ const size_t size=65536;
+ HANDLE section=CreateFileMappingW(INVALID_HANDLE_VALUE,NULL,PAGE_READWRITE,0,(DWORD)size,NULL);
+unsigned char *ram=MapViewOfFile(section,FILE_MAP_ALL_ACCESS,0,0,size);
+ if(!ram) return 2;
+ unsigned char *pixels=ram+(boundary?0xc000:0);
+ for(int y=0;y<32;y++) for(int x=0;x<64;x++) {unsigned char *p=pixels+256*y+4*x;p[0]=x;p[1]=y;p[2]=x^y;p[3]=255;}
+ RvgMemoryRange range={0x100000,size,ram}; RvgMemoryMap map={&range,1};
+ RvgDeviceConfig dc={0}; dc.struct_size=sizeof(dc);dc.display_port_count=1;dc.memory_map=&map;
+RvgMemoryRangeSection backing={(uint64_t)(uintptr_t)section,0,size,0,0};dc.memory_sections=&backing;
+ RvgDevice *dev=NULL; CHECK(rvg_device_create(&dc,&dev));
+ RvgDisplayConfig displayc={0};displayc.struct_size=sizeof(displayc);displayc.serial_number=7391;
+RvgDisplayCallbacks callbacks={0};callbacks.struct_size=sizeof(callbacks);callbacks.new_frame=on_frame;displayc.callbacks=&callbacks;
+ RvgDisplay *display=NULL;CHECK(rvg_display_create(dev,&displayc,&display));
+ RvgDisplayMode mode={64,32,0,60.0};rvg_display_set_modes(display,&mode,1);
+ rvg_device_mmio_write(dev,0x1034,0xf5);
+ rvg_device_mmio_write(dev,0x1200,1);rvg_device_mmio_write(dev,0x121c,64|(32<<16));
+ rvg_device_mmio_write(dev,0x1218,32);rvg_device_mmio_write(dev,0x1228,256);
+ rvg_device_mmio_write(dev,0x1210,(outside?0x110000:(boundary?0x10c000:0x100000))>>14);rvg_device_mmio_write(dev,0x1214,invalid_length?0x3000:0x4000);
+ Sleep(500);
+ if(invalid_length||outside) {uint64_t guest=0,host=0;rvg_display_present_counts(display,&guest,&host);printf("Rejected fixture %s: guest=%llu callbacks=%ld\n",argv[1],(unsigned long long)guest,received_frames);rvg_device_mmio_write(dev,0x1218,0);rvg_display_release(display);rvg_device_release(dev);UnmapViewOfFile(ram);CloseHandle(section);return guest||received_frames?6:0;}
+
+ RvgFrameTargetConfig tc={sizeof(tc),64,32,RVG_PIXEL_FORMAT_BGRA8_UNORM};RvgFrameTarget *target=NULL;
+ CHECK(rvg_frame_target_create(dev,&tc,&target));RvgFrame *frame=NULL;
+ CHECK(rvg_display_encode_frame(display,target,NULL,&frame));CHECK(rvg_frame_commit(frame));CHECK(rvg_frame_wait(frame));
+ unsigned char result[8192];CHECK(rvg_frame_target_read_pixels(target,result,256,sizeof(result)));
+for(int pass=0;pass<16;pass++){ rvg_frame_release(frame);frame=NULL;Sleep(100); CHECK(rvg_display_encode_frame(display,target,NULL,&frame)); CHECK(rvg_frame_commit(frame)); CHECK(rvg_frame_wait(frame)); }
+uint64_t guest=0,host=0;rvg_display_present_counts(display,&guest,&host);printf("presents guest=%llu host=%llu\n",(unsigned long long)guest,(unsigned long long)host);
+ unsigned errors=0;for(size_t i=0;i<sizeof(result);i++) if(result[i]!=pixels[i]) {if(errors<8)printf("mismatch %zu expected=%u got=%u\n",i,pixels[i],result[i]);errors++;}
+ printf("EFI GPU framebuffer readback: mismatched_bytes=%u of %zu\n",errors,sizeof(result));
+ rvg_device_mmio_write(dev,0x1218,0);rvg_frame_release(frame);rvg_frame_target_release(target);rvg_display_release(display);rvg_device_release(dev);UnmapViewOfFile(ram);CloseHandle(section);
+ return errors?3:0;
+}
