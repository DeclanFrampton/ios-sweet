+/// Opt-in, bounded local evidence for a rejected guest library. Never overwrite an artifact.
+fn capture_rejected_library(data: &[u8], reason: &str) {
+    use std::io::Write;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    static NEXT: AtomicUsize = AtomicUsize::new(0);
+    let Some(directory) = std::env::var_os("REIMS_VGPU_REJECTED_LIBRARY_DIR") else { return; };
+    if data.len() > 16 * 1024 * 1024 { return; }
+    let index = NEXT.fetch_add(1, Ordering::Relaxed);
+    if index >= 4 { return; }
+    let base = std::path::PathBuf::from(directory).join(format!("rejected-{index:04}"));
+    let result = (|| -> std::io::Result<()> {
+        let mut file = std::fs::OpenOptions::new().write(true).create_new(true).open(base.with_extension("bin"))?;
+        file.write_all(data)?;
+        let mut note = std::fs::OpenOptions::new().write(true).create_new(true).open(base.with_extension("txt"))?;
+        writeln!(note, "{reason}\n{} bytes", data.len())?;
+        Ok(())
+    })();
+    if let Err(error) = result { log::warn!("rejected-library capture failed: {error}"); }
+}
