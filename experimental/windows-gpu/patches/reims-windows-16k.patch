+        assert_eq!(r.dev.state.lock().table_len, 0x4000 / 4);
+        // A valid final full page maps, while a 4 KiB tail cannot supply a guest page.
+        r.dev.mmio_write(REG_DESCRIPTOR_BASE, B + RAM_PAGES * PAGE - 0x4000);
+        assert_eq!(r.dev.maps.lock().table.as_ref().unwrap().length(), 0x4000);
+        r.dev.mmio_write(REG_DESCRIPTOR_BASE, B + RAM_PAGES * PAGE - 0x1000);
+        assert!(r.dev.maps.lock().table.is_none());
+        r.dev.mmio_write(REG_DESCRIPTOR_BASE, HOLE);
+        assert!(r.dev.maps.lock().table.is_none());
+        r.dev.mmio_write(REG_DESCRIPTOR_BASE, 0);
+    }
